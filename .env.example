# Docker settings — copy to .env and fill in. All optional; anything left empty
# can be entered in the page instead. No secrets belong here (never the passphrase).

# Your Passbolt server, e.g. https://passbolt.example.com
PASSBOLT_BASE_URL=

# Only for JWT servers (typical for Passbolt 5). Hover the "?" next to the field in
# the page for where to find it.
PASSBOLT_USER_ID=

# Files you placed in ./keys, as seen INSIDE the container:
# PASSBOLT_KEY_FILE=/keys/passbolt-recovery-kit.asc
# PASSBOLT_CA_FILE=/keys/company-ca.pem
PASSBOLT_KEY_FILE=
PASSBOLT_CA_FILE=
